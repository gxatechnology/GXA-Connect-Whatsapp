# ==============================================================================
# GXA CONNECT — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to .env or configure directly in your cloud hosting provider (e.g. Vercel).
# All secrets and URLs below must be replaced with strong, unique production values.

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME MODE
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=2785

# Runtime capability mode:
# - 'serverless' (API-only, WhatsApp socket background loops disabled; default on Vercel)
# - 'worker'     (Background campaign processing and WhatsApp socket execution)
# - 'standalone' (All-in-one container or VM instance)
RUNTIME_MODE=serverless

# ------------------------------------------------------------------------------
# 2. MANAGED POSTGRESQL DATABASE (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
DATABASE_TYPE=postgres

# Unified PostgreSQL Connection URL (e.g. Neon, Supabase, AWS RDS)
DATABASE_URL=postgresql://postgres_user:strong_password@ep-sample-123.region.aws.neon.tech/gxa_connect?sslmode=require

# (Optional) Discrete connection parameters if not using DATABASE_URL:
# DATABASE_HOST=db.example.com
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres_user
# DATABASE_PASSWORD=strong_password
# DATABASE_NAME=gxa_connect
# DATABASE_SSL=true

# Database migrations:
# Schema is managed strictly through migrations in production.
DATABASE_SYNCHRONIZE=false
MAIN_DATABASE_SYNCHRONIZE=false

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Strong random secret for user JWT/session tokens (MINIMUM 32 CHARACTERS)
# Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_of_32_chars_or_more

# Optional API Master Key (allows root system access if set; must NOT be a default/weak value)
# API_MASTER_KEY=

# Server pepper for hashing developer API keys (recommended in production)
# API_KEY_PEPPER=

# ------------------------------------------------------------------------------
# 4. INITIAL PLATFORM SUPER ADMIN BOOTSTRAP
# ------------------------------------------------------------------------------
# Used ONLY on fresh boot when no users exist in the database.
# Existing admins are NEVER modified or reset if users already exist.
ADMIN_EMAIL=superadmin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_initial_password_here
ADMIN_FULL_NAME="Super Administrator"

# ------------------------------------------------------------------------------
# 5. CORS & DASHBOARD NETWORKING
# ------------------------------------------------------------------------------
# Allowed origins for API requests (comma-separated). In production, wildcard '*' is rejected.
CORS_ORIGIN=https://gxa-connect.vercel.app,https://yourcustomdomain.com

# ------------------------------------------------------------------------------
# 6. MEDIA STORAGE (S3 COMPATIBLE / AWS / CLOUDFLARE R2)
# ------------------------------------------------------------------------------
STORAGE_TYPE=s3
S3_BUCKET=gxa-connect-media
S3_REGION=us-east-1
S3_ACCESS_KEY=your_production_s3_access_key
S3_SECRET_KEY=your_production_s3_secret_key
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 7. WHATSAPP ENGINE & WORKER SETTINGS
# ------------------------------------------------------------------------------
ENGINE_TYPE=baileys
AUTO_START_SESSIONS=false
